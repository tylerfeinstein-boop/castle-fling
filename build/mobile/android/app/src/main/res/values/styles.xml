<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
    </style>


    <!-- Launch theme ONLY. Theme.SplashScreen is a hand-off theme: it must be
         swapped for postSplashScreenTheme by SplashScreen.installSplashScreen()
         in MainActivity.onCreate. Without that swap the Activity keeps this
         theme for its whole life, which meant two visible bugs: the AppCompat
         title bar stayed (showing @string/title_activity_main), and the
         android:background below — a FULL-SCREEN splash bitmap — became the
         default background for any view without its own, so it rendered as a
         stretched strip inside that bar. postSplashScreenTheme hands over to
         AppTheme.NoActionBar, which kills the title bar and resets the
         background to @null. -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
    </style>
</resources>